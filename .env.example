# Copy to .env.local (gitignored) and fill in from Supabase → Project Settings → API.
# The publishable key is safe for the client — RLS is what actually protects data.
#
# NEXT_PUBLIC_* vars are inlined into the browser bundle at BUILD time, so they
# must be set in the Vercel project settings (not just at runtime) for a real
# deploy. CI builds without them on purpose (it's a gate, never deployed).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Post-death recap (#13, ADR-0004). Deliberately NOT prefixed NEXT_PUBLIC_ —
# it must stay server-only, read only from src/app/api/recap/handler.ts (see
# keyLeak.test.ts, part of `npm test`, which fails if that ever stops being
# true). Optional: without it, the recap route degrades to no recap rather
# than erroring (ADR-0004's non-blocking-by-construction). `npm test` never
# needs this set — provider calls are mocked in that suite.
OPENAI_API_KEY=
